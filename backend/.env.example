# Database
DB_HOST=127.0.0.1
DB_DATABASE=your_db
DB_USERNAME=root
DB_PASSWORD=your_password

# Laravel APP_KEY for encryption (same as Laravel .env)
LARAVEL_APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=
CLIENT_ENCRYPTION_KEY=your_base64_aes_key_here

# JWT
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1d

# Banner Toggle
BANNER_TOGGLE_SECRET=789

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
ADMIN_EMAIL=admin@example.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173